{
  "name": "mithara-admin",
  "productName": "Mithara Admin",
  "version": "1.0.0",
  "description": "Mithara management system (orders, kitchen, invoices, menu, revenue)",
  "main": "main.js",
  "author": "Mithara",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mithara.admin",
    "productName": "Mithara Admin",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "offline.html", "splash.html", "config.json", "build/icon.png", "build/logo.png"],
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
